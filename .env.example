# Waypoint Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
DB_CONNECTION_STRING=postgresql://username:password@hostname:port/database
DB_NAME=waypoint
DB_USER=waypoint_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Authentication
JWT_SECRET=replace_with_secure_random_string
JWT_EXPIRES_IN=24h
JWT_ISSUER=waypoint_api
JWT_AUDIENCE=waypoint_clients
JWT_EXPIRY_MINUTES=60

# Application Settings
PORT=3000
NODE_ENV=development
API_URL=http://localhost:8080

# External Services
# Mapbox API (for geocoding)
MAPBOX_API_KEY=your_mapbox_api_key_here

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_MAPBOX_TOKEN=your_mapbox_api_key_here

# Other External Services (uncomment as needed)
# STRIPE_API_KEY=your_stripe_api_key
# SENDGRID_API_KEY=your_sendgrid_api_key

# Logging
LOG_LEVEL=debug 