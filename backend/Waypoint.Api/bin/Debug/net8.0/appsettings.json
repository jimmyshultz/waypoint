{
  "ConnectionStrings": {
    "DefaultConnection": "PLACEHOLDER_CONNECTION_STRING"
  },
  "JwtSettings": {
    "Key": "PLACEHOLDER_JWT_SECRET_KEY",
    "Issuer": "waypoint_api",
    "Audience": "waypoint_clients",
    "DurationInMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
